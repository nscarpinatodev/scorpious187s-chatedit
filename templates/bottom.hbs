<textarea name="content" autocomplete="off">{{content}}</textarea>
{{#if markdownEnabled}}
<h5>{{localize "CHATEDIT.EDITS.Preview"}}</h5>
<div class="chatedit-preview" data-preview aria-live="polite"></div>
{{/if}}
<br>
<div class="actions">
  <button type="submit">
    <i class="fa-solid fa-save"></i>
    {{localize "Save"}}
  </button>
  <button type="button" data-action="close">
    <i class="fa-solid fa-xmark"></i>
    {{localize "Cancel"}}
  </button>
</div>